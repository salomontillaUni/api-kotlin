<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/meal_bg_soft"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado de la Aplicación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_app"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/meal_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subtitle_app"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Campo de Entrada de Receta -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_receta"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/meal_primary"
            app:hintTextColor="@color/meal_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReceta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botones de Acción Primaria -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuscar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/btn_buscar"
                android:backgroundTint="@color/meal_primary"
                android:textColor="@color/white"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAleatorio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/btn_aleatorio"
                android:backgroundTint="@color/meal_accent"
                android:textColor="@color/white"
                app:cornerRadius="10dp" />

        </LinearLayout>

        <!-- Botón de Reto Opcional: Filtrar por Ingrediente -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPorIngrediente"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/btn_por_ingrediente"
            android:textColor="@color/meal_primary"
            app:strokeColor="@color/meal_primary"
            app:cornerRadius="10dp" />

        <!-- Barra de Progreso / Cargando -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/meal_primary"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Mensaje de Error -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:background="@drawable/bg_card"
            android:textColor="@color/error_red"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="❌ Error de conexión con la API"
            tools:visibility="visible" />

        <!-- Tarjeta de Resultados de la Receta -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Imagen del Plato con Coil -->
                <ImageView
                    android:id="@+id/ivFoto"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto de la receta"
                    tools:srcCompat="@android:drawable/ic_menu_gallery" />

                <!-- Cuerpo con los datos de la receta -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Nombre de la Receta -->
                    <TextView
                        android:id="@+id/tvNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        tools:text="Spicy Arrabiata Penne" />

                    <!-- Metadatos: ID, Categoría, Área, Tags -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_badge">

                        <TextView
                            android:id="@+id/tvId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            tools:text="ID: 52771" />

                        <TextView
                            android:id="@+id/tvCategoria"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            tools:text="📂 Categoría: Vegetarian" />

                        <TextView
                            android:id="@+id/tvArea"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            tools:text="🌍 País de origen: Italian" />

                        <TextView
                            android:id="@+id/tvTags"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            tools:text="🏷️ Tags: Pasta,Curry" />

                    </LinearLayout>

                    <!-- Reto Opcional: Botón de YouTube -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnYoutube"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/btn_youtube"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/youtube_red"
                        app:icon="@drawable/ic_youtube"
                        app:iconGravity="textStart"
                        app:iconTint="@color/white"
                        app:cornerRadius="10dp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <!-- Sección de Ingredientes -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/label_ingredientes"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvIngredientes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        tools:text="• penne rigate (1 pound)\n• olive oil (1/4 cup)\n• garlic (3 cloves)" />

                    <!-- Reto Opcional: Instrucciones de Preparación con Toggle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleInstrucciones"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_mostrar_instrucciones"
                            android:textColor="@color/meal_primary"
                            app:cornerRadius="10dp" />

                        <TextView
                            android:id="@+id/tvInstrucciones"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="4dp"
                            android:padding="12dp"
                            android:background="@drawable/bg_card"
                            android:textColor="@color/text_secondary"
                            android:textSize="13.5sp"
                            android:visibility="gone"
                            tools:text="Bring a large pot of water to a boil. Add kosher salt to the boiling water, then add the pasta..."
                            tools:visibility="visible" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
